# Copy to .streamlit/secrets.toml (local) or paste into the Secrets box in
# Streamlit Community Cloud. Placeholders only -- never commit real values.

# Google AI Studio key with the Gemini API enabled. Required for live research.
GOOGLE_API_KEY = "REPLACE_WITH_YOUR_GOOGLE_AI_STUDIO_KEY"

# Optional. Supabase Postgres connection string for hosted run history.
# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the connection pooler (port 6543) for Streamlit Community Cloud.
# Leave this out entirely to keep history in a local SQLite file.
DATABASE_URL = "postgresql://postgres.PROJECTREF:REPLACE_WITH_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require"
